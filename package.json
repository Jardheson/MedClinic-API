{
  "name": "medclinic-api",
  "version": "1.0.0",
  "description": "MedClinic API - Etapa 2 (Agendamento, escala e prontuário)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "db:prepare": "tsx src/scripts/prepare-database.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/MedClinicInit -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts"
  },
  "keywords": [
    "medclinic",
    "api",
    "express",
    "typescript",
    "typeorm",
    "postgresql",
    "jwt",
    "rbac"
  ],
  "author": "Jardheson Oliveira",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
